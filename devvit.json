{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "flip-and-fry",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "splash.html"
      },
      "game": {
        "entry": "game.html"
      }
    }
  },
  "marketingAssets": {
    "icon": "public/icon-pixel.png"
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "http": {
      "enable": false
    },
    "reddit": {
      "enable": true,
      "asUser": [
        "SUBMIT_POST",
        "SUBMIT_COMMENT",
        "SUBSCRIBE_TO_SUBREDDIT"
      ]
    },
    "journeys": true,
    "realtime": true,
    "media": true
  },
  "menu": {
    "items": [
      {
        "label": "Highlight today's post",
        "description": "Pin today's Flip and Fry post in the community highlights",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/highlight-today"
      },
      {
        "label": "Post today's service",
        "description": "Create a Flip and Fry post",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-today"
      },
      {
        "label": "Retention report",
        "description": "Players, daily and monthly actives, and day 1, 7 and 30 return rates (totals only)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/retention-report"
      },
      {
        "label": "Playtest: skip 6 hours of my garden timers",
        "description": "Moves your own crops, builder and workshop timers forward six hours so a tester can see them ready (moderators only)",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/skip-timers"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install",
    "onCommentDelete": "/internal/triggers/comment-delete",
    "onPostDelete": "/internal/triggers/post-delete"
  },
  "settings": {
    "subreddit": {
      "neighborhood": {
        "type": "string",
        "label": "Neighborhood name",
        "helpText": "Shown on the daily bar. Letters, numbers, spaces and apostrophes, up to 24 characters.",
        "placeholder": "Maple Street",
        "validationEndpoint": "/internal/settings/validate-neighborhood"
      },
      "openDoors": {
        "type": "boolean",
        "label": "Allow open doors",
        "helpText": "Let players leave their kitchen open for neighbors to visit.",
        "defaultValue": true
      }
    }
  },
  "scripts": {
    "build": "vite build --config vite.devvit.config.ts",
    "dev": "vite build --config vite.devvit.config.ts --watch"
  },
  "dev": {
    "subreddit": "flip_and_fry_dev"
  },
  "scheduler": {
    "tasks": {
      "roll-day": {
        "endpoint": "/internal/scheduler/roll-day",
        "cron": "5 0 * * *"
      },
      "streak-reminders": {
        "endpoint": "/internal/scheduler/streak-reminders",
        "cron": "0 17 * * *"
      },
      "night-report": {
        "endpoint": "/internal/scheduler/night-report",
        "cron": "20 0 * * *"
      }
    }
  }
}
